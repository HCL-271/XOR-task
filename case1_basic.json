  "procedure_sql": "CREATE OR REPLACE PROCEDURE pre_dm.load_dim_active_agree_case1_basic()\n LANGUAGE plpgsql\nAS $procedure$\nDECLARE\n    v_today DATE := DATE '2025-01-15';\n    v_now   TIMESTAMP := TIMESTAMP '2025-01-15 12:00:00';\nBEGIN\n    TRUNCATE TABLE pre_dm.dim_active_agree;\n\n    INSERT INTO pre_dm.dim_active_agree\n    SELECT\n        ag.agree_sk,\n        ag.open_dt  AS agree_open_dt,\n        ag.close_dt AS agree_close_dt,\n        ag.agree_state,\n\n        CASE WHEN ag.agree_state IN ('ACTIVE','OVERDUE') THEN TRUE ELSE FALSE END AS is_active,\n\n        v_today - ag.open_dt AS agree_age_days,\n\n        CASE\n            WHEN ag.close_dt IS NOT NULL THEN ag.close_dt - ag.open_dt\n            ELSE v_today - ag.open_dt\n        END AS agree_duration_day_cnt,\n\n        CASE\n            WHEN ag.currency_name = 'RUB' THEN ag.open_amt\n            ELSE ag.open_amt *\n                CASE\n                    WHEN ag.currency_name = 'USD' THEN 90\n                    WHEN ag.currency_name = 'EUR' THEN 100\n                    ELSE 1\n                END\n        END AS open_rub_amt,\n\n        v_now AS etl_updated_dttm\n    FROM dds.dim_agree ag\n    WHERE\n        (ag.valid_to_dttm IS NULL OR ag.valid_to_dttm > v_now)\n        AND ag.source_system = 'Автоматизированная банковская система';\nEND;\n$procedure$;",
