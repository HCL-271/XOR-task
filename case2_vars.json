  "case_id": "case2_vars",
  "description": "Variable-driven case: active_states array + FX rates vars + strict valid_to_dttm > as_of_ts. Params must be extracted from SQL.",
  "as_of_date": "2025-02-01",
  "as_of_ts": "2025-02-01 00:00:00",
  "procedure_sql": "CREATE OR REPLACE PROCEDURE pre_dm.load_dim_active_agree_case2()\nLANGUAGE plpgsql\nAS $procedure$\nDECLARE\n    v_today DATE := DATE '2025-02-01';\n    v_now   TIMESTAMP := TIMESTAMP '2025-02-01 00:00:00';\n\n    -- FX multipliers (int for this toy task)\n    v_usd_rate INTEGER := 87;\n    v_eur_rate INTEGER := 103;\n    v_default_rate INTEGER := 2;\n\n    -- NOTE: OVERDUE is NOT active in this case.\n    v_active_states TEXT[] := ARRAY['ACTIVE', 'OPEN'];\nBEGIN\n    TRUNCATE TABLE pre_dm.dim_active_agree;\n\n    INSERT INTO pre_dm.dim_active_agree\n    SELECT\n        ag.agree_sk,\n        ag.open_dt AS agree_open_dt,\n        ag.close_dt AS agree_close_dt,\n        ag.agree_state,\n\n        CASE\n            WHEN ag.agree_state = ANY(v_active_states) THEN TRUE\n            ELSE FALSE\n        END AS is_active,\n\n        v_today - ag.open_dt AS agree_age_days,\n\n        CASE\n            WHEN ag.close_dt IS NOT NULL THEN ag.close_dt - ag.open_dt\n            ELSE v_today - ag.open_dt\n        END AS agree_duration_day_cnt,\n\n        CASE\n            WHEN ag.currency_name = 'RUB' THEN ag.open_amt\n            ELSE ag.open_amt *\n                CASE\n                    WHEN ag.currency_name = 'USD' THEN v_usd_rate\n                    WHEN ag.currency_name = 'EUR' THEN v_eur_rate\n                    ELSE v_default_rate\n                END\n        END AS open_rub_amt,\n\n        v_now AS etl_updated_dttm\n    FROM dds.dim_agree ag\n    WHERE\n        (ag.valid_to_dttm IS NULL OR ag.valid_to_dttm > v_now)\n        AND ag.source_system = 'Автоматизированная банковская система';\nEND;\n$procedure$;",
